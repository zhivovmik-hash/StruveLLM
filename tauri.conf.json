{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Struve LLM",
  "version": "0.8.2",
  "identifier": "org.struve.llm",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:15417"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Struve LLM",
        "width": 1380,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#171819"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
