+    size_t GraphCutTensorCache::stage_input_bytes(ggml_backend_t backend, const ggml_graph_cut::Segment& segment) const {
+        if (!uses_host_cache()) return 0;
+        auto buft = ggml_backend_get_default_buffer_type(backend);
+        size_t bytes = 0;
+        std::unordered_set<std::string> seen;
+        for (const auto& input : segment.input_refs) {
+            if (input.type != ggml_graph_cut::Segment::INPUT_PREVIOUS_CUT || !seen.insert(input.display_name).second) continue;
+            auto tensor = cached_tensor(tensors_, input.display_name);
+            GGML_ASSERT(tensor != nullptr);
+            bytes += GGML_PAD(ggml_backend_buft_get_alloc_size(buft, tensor), ggml_backend_buft_get_alignment(buft));
+        }
+        return bytes;
+    }
+
+    ggml_status GraphCutTensorCache::stage_inputs(ggml_backend_t backend, const ggml_graph_cut::Segment& segment) {
+        clear_staged_inputs();
+        if (!uses_host_cache()) return GGML_STATUS_SUCCESS;
+        for (const auto& input : segment.input_refs) {
+            if (input.type != ggml_graph_cut::Segment::INPUT_PREVIOUS_CUT || staged_inputs_.count(input.display_name)) continue;
+            auto source = cached_tensor(tensors_, input.display_name);
+            if (source == nullptr) return GGML_STATUS_FAILED;
+            ggml_status status;
+            auto entry = CachedTensor::copy(backend, input.display_name, source, status);
+            if (entry == nullptr) return status;
+            staged_inputs_[input.display_name] = std::move(entry);
+        }
+        ggml_backend_synchronize(backend);
+        return GGML_STATUS_SUCCESS;
     }
 
